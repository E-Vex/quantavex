new file mode 100644
index 00000000000..7b72a3aae17
--- /dev/null
+++ b/browser/extensions/newtab/content-src/components/Logo/BlackHoleLogo.jsx
@@ -0,0 +1,255 @@
+import React, { useEffect, useRef, useState } from "react";
+
+const ROTATION_PERIOD_MS = 22000;
+const COMET_MIN_GAP_MS = 4000;
+const COMET_MAX_GAP_MS = 7000;
+const COMET_TRAVEL_MS = 900;
+const FLASH_DURATION_MS = 450;
+
+function useReducedMotion() {
+  const [reduced, setReduced] = useState(
+    () => window.matchMedia("(prefers-reduced-motion: reduce)").matches
+  );
+  useEffect(() => {
+    const mql = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const onChange = () => setReduced(mql.matches);
+    mql.addEventListener("change", onChange);
+    return () => mql.removeEventListener("change", onChange);
+  }, []);
+  return reduced;
+}
+
+function drawDisk(ctx, cx, cy, rInner, rOuter, angle) {
+  ctx.save();
+  ctx.translate(cx, cy);
+  ctx.rotate(angle);
+  const grad = ctx.createConicGradient(0, 0, 0);
+  grad.addColorStop(0, "#3a1204");
+  grad.addColorStop(0.12, "#ffd77a");
+  grad.addColorStop(0.22, "#ff9d3d");
+  grad.addColorStop(0.4, "#7a2a0a");
+  grad.addColorStop(0.5, "#2a0e04");
+  grad.addColorStop(0.62, "#7a2a0a");
+  grad.addColorStop(0.82, "#ffb454");
+  grad.addColorStop(0.92, "#ffe6a8");
+  grad.addColorStop(1, "#3a1204");
+  ctx.beginPath();
+  ctx.arc(0, 0, rOuter, 0, Math.PI * 2, false);
+  ctx.arc(0, 0, rInner, 0, Math.PI * 2, true);
+  ctx.closePath();
+  ctx.fillStyle = grad;
+  ctx.fill("evenodd");
+  const fade = ctx.createRadialGradient(0, 0, rInner, 0, 0, rOuter);
+  fade.addColorStop(0, "rgba(0,0,0,0)");
+  fade.addColorStop(0.7, "rgba(0,0,0,0)");
+  fade.addColorStop(1, "rgba(0,0,0,0.9)");
+  ctx.globalCompositeOperation = "destination-out";
+  ctx.beginPath();
+  ctx.arc(0, 0, rOuter, 0, Math.PI * 2);
+  ctx.fillStyle = fade;
+  ctx.fill();
+  ctx.restore();
+}
+
+function drawPhotonRing(ctx, cx, cy, r) {
+  ctx.save();
+  ctx.filter = "blur(2px)";
+  ctx.strokeStyle = "rgba(255,226,170,0.9)";
+  ctx.lineWidth = 2;
+  ctx.beginPath();
+  ctx.arc(cx, cy, r, 0, Math.PI * 2);
+  ctx.stroke();
+  ctx.filter = "none";
+  ctx.strokeStyle = "rgba(255,245,220,0.95)";
+  ctx.lineWidth = 0.8;
+  ctx.beginPath();
+  ctx.arc(cx, cy, r, 0, Math.PI * 2);
+  ctx.stroke();
+  ctx.restore();
+}
+
+function drawHorizon(ctx, cx, cy, r) {
+  ctx.save();
+  const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
+  g.addColorStop(0, "#000000");
+  g.addColorStop(1, "#0a0605");
+  ctx.fillStyle = g;
+  ctx.beginPath();
+  ctx.arc(cx, cy, r, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.strokeStyle = "rgba(255,255,255,0.18)";
+  ctx.lineWidth = 0.6;
+  ctx.beginPath();
+  ctx.arc(cx, cy, r * 0.4, 0, Math.PI * 2);
+  ctx.stroke();
+  ctx.beginPath();
+  ctx.arc(cx + r * 0.09, cy - r * 0.02, r * 0.05, 0, Math.PI * 2);
+  ctx.strokeStyle = "rgba(255,255,255,0.22)";
+  ctx.lineWidth = 0.6;
+  ctx.stroke();
+  ctx.restore();
+}
+
+function spawnComet(width, height) {
+  const angle = Math.random() * Math.PI * 2;
+  return {
+    angle,
+    startRadius: Math.max(width, height) * 1.1,
+    spin: (Math.random() > 0.5 ? 1 : -1) * (2 + Math.random() * 1.5),
+    born: performance.now(),
+    trail: [],
+  };
+}
+
+export function BlackHoleLogo({ className }) {
+  const canvasRef = useRef(null);
+  const reducedMotion = useReducedMotion();
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) {
+      return undefined;
+    }
+    const ctx = canvas.getContext("2d");
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+    let width = 0;
+    let height = 0;
+    let rafId = null;
+    let comet = null;
+    let nextCometAt = performance.now() + COMET_MIN_GAP_MS;
+    let flash = null;
+
+    function renderStatic() {
+      const cx = width / 2;
+      const cy = height / 2;
+      const r = Math.min(width, height) / 2;
+      ctx.clearRect(0, 0, width, height);
+      drawDisk(ctx, cx, cy, r * 0.44, r * 0.96, 0);
+      drawPhotonRing(ctx, cx, cy, r * 0.46);
+      drawHorizon(ctx, cx, cy, r * 0.42);
+    }
+
+    function resize() {
+      const rect = canvas.getBoundingClientRect();
+      const w = Math.round(rect.width);
+      const h = Math.round(rect.height);
+      if (!w || !h) {
+        return;
+      }
+      width = w;
+      height = h;
+      canvas.width = width * dpr;
+      canvas.height = height * dpr;
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      if (reducedMotion) {
+        renderStatic();
+      }
+    }
+
+    // Helper: handles comet spawning, movement, drawing, and completion
+    function processComet(now, cx, cy, r) {
+      if (!comet && now >= nextCometAt) {
+        comet = spawnComet(width, height);
+      }
+      if (comet) {
+        const t = Math.min(1, (now - comet.born) / COMET_TRAVEL_MS);
+        const ease = t * t;
+        const radius = comet.startRadius * (1 - ease);
+        const a = comet.angle + ease * comet.spin;
+        const x = cx + Math.cos(a) * radius;
+        const y = cy + Math.sin(a) * radius;
+        comet.trail.push({ x, y });
+        if (comet.trail.length > 6) {
+          comet.trail.shift();
+        }
+        ctx.save();
+        ctx.strokeStyle = "rgba(255,214,140,0.5)";
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        comet.trail.forEach((p, i) => {
+          if (i === 0) {
+            ctx.moveTo(p.x, p.y);
+          } else {
+            ctx.lineTo(p.x, p.y);
+          }
+        });
+        ctx.stroke();
+        ctx.filter = "blur(1.5px)";
+        ctx.fillStyle = "rgba(255,240,210,0.95)";
+        ctx.beginPath();
+        ctx.arc(x, y, 1.8, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.filter = "none";
+        ctx.restore();
+        if (t >= 1) {
+          flash = { born: now, x: cx, y: cy, r: r * 0.46 };
+          comet = null;
+          nextCometAt =
+            now +
+            COMET_MIN_GAP_MS +
+            Math.random() * (COMET_MAX_GAP_MS - COMET_MIN_GAP_MS);
+        }
+      }
+    }
+
+    // Helper: handles the flash animation
+    function processFlash(now) {
+      if (flash) {
+        const ft = (now - flash.born) / FLASH_DURATION_MS;
+        if (ft >= 1) {
+          flash = null;
+        } else {
+          ctx.save();
+          ctx.globalAlpha = 1 - ft;
+          ctx.strokeStyle = "rgba(255,236,190,0.9)";
+          ctx.lineWidth = 1.5;
+          ctx.beginPath();
+          ctx.arc(flash.x, flash.y, flash.r * (1 + ft * 0.6), 0, Math.PI * 2);
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+    }
+
+    function frame(now) {
+      if (!width || !height) {
+        rafId = requestAnimationFrame(frame);
+        return;
+      }
+      const cx = width / 2;
+      const cy = height / 2;
+      const r = Math.min(width, height) / 2;
+      const angle =
+        ((now % ROTATION_PERIOD_MS) / ROTATION_PERIOD_MS) * Math.PI * 2;
+
+      ctx.clearRect(0, 0, width, height);
+      drawDisk(ctx, cx, cy, r * 0.44, r * 0.96, angle);
+
+      processComet(now, cx, cy, r);
+
+      drawPhotonRing(ctx, cx, cy, r * 0.46);
+
+      processFlash(now);
+
+      drawHorizon(ctx, cx, cy, r * 0.42);
+
+      rafId = requestAnimationFrame(frame);
+    }
+
+    const ro = new ResizeObserver(resize);
+    ro.observe(canvas);
+    resize();
+    if (!reducedMotion) {
+      rafId = requestAnimationFrame(frame);
+    }
+
+    return () => {
+      ro.disconnect();
+      if (rafId) {
+        cancelAnimationFrame(rafId);
+      }
+    };
+  }, [reducedMotion]);
+
+  return <canvas ref={canvasRef} className={className} aria-hidden="true" />;
+}
