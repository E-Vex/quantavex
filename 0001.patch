diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 838ce4cd848..043ec05ac03 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3611,6 +3611,11 @@ pref("toolkit.rust-components.logging.internal-level", "Warn");
 // Settings Redesign 2025 prefs
 pref("browser.settings-redesign.enabled", true);
 
+pref("browser.startup.page", 0);
+pref("browser.startup.homepage", "about:newtab");
+pref("browser.aboutwelcome.enabled", false);
+pref("browser.startup.homepage_override.mstone", "ignore");
+
 // A preference that will be locked to reflect whether this build has support
 // for XDG Config Home handling. Mostly used to be able to keep tests around
 // in case of a backout of the feature
diff --git a/browser/branding/nightly/locales/en-US/brand.ftl b/browser/branding/nightly/locales/en-US/brand.ftl
index 86770b0374c..bade80dfc86 100644
--- a/browser/branding/nightly/locales/en-US/brand.ftl
+++ b/browser/branding/nightly/locales/en-US/brand.ftl
@@ -2,9 +2,9 @@
 # License, v. 2.0. If a copy of the MPL was not distributed with this
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-## Firefox and Mozilla Brand
+## Quantavex Brand
 ##
-## Firefox and Mozilla must be treated as a brand.
+## Quantavex must be treated as a brand.
 ##
 ## They cannot be:
 ## - Transliterated.
@@ -12,16 +12,13 @@
 ##
 ## Declension should be avoided where possible, leaving the original
 ## brand unaltered in prominent UI positions.
-##
-## For further details, consult:
-## https://mozilla-l10n.github.io/styleguides/mozilla_general/#brands-copyright-and-trademark
 
--brand-shorter-name = Nightly
--brand-short-name = Nightly
--brand-shortcut-name = Firefox Nightly
--brand-full-name = Firefox Nightly
+-brand-shorter-name = Quantavex
+-brand-short-name = Quantavex
+-brand-shortcut-name = Quantavex
+-brand-full-name = Quantavex
 # This brand name can be used in messages where the product name needs to
 # remain unchanged across different versions (Nightly, Beta, etc.).
--brand-product-name = Firefox
--vendor-short-name = Mozilla
-trademarkInfo = { " " }
+-brand-product-name = Quantavex
+-vendor-short-name = Quantavex
+trademarkInfo = { " " }
\ No newline at end of file
