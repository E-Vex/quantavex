diff --git a/browser/extensions/newtab/content-src/components/Logo/LivingAtom.jsx b/browser/extensions/newtab/content-src/components/Logo/LivingAtom.jsx
new file mode 100644
index 00000000000..51453963c4d
--- /dev/null
+++ b/browser/extensions/newtab/content-src/components/Logo/LivingAtom.jsx
@@ -0,0 +1,378 @@
+import React, { useEffect, useRef, useState } from "react";
+
+function useReducedMotion() {
+  const [reduced, setReduced] = useState(
+    () => window.matchMedia("(prefers-reduced-motion: reduce)").matches
+  );
+
+  useEffect(() => {
+    const mql = window.matchMedia("(prefers-reduced-motion: reduce)");
+
+    const onChange = () => setReduced(mql.matches);
+
+    mql.addEventListener("change", onChange);
+
+    return () => mql.removeEventListener("change", onChange);
+  }, []);
+
+  return reduced;
+}
+
+const NUM_NUCLEONS = 15;
+const DESIGN_BASE = 400;
+
+const ORBIT_DEFS = [
+  { rotation: 0, speed: 0.04, startAngle: 0 },
+  { rotation: Math.PI / 3, speed: 0.035, startAngle: Math.PI },
+  {
+    rotation: -Math.PI / 3,
+    speed: 0.045,
+    startAngle: Math.PI / 2,
+  },
+  {
+    rotation: Math.PI / 1.5,
+    speed: 0.03,
+    startAngle: (Math.PI * 3) / 2,
+  },
+];
+
+function makeNucleons() {
+  const arr = [];
+
+  for (let i = 0; i < NUM_NUCLEONS; i++) {
+    arr.push({
+      ux: Math.random() - 0.5,
+      uy: Math.random() - 0.5,
+      color: Math.random() > 0.5 ? "#ff2a5f" : "#2a7fff",
+      baseRadius: Math.random() * 2 + 4,
+      angle: Math.random() * Math.PI * 2,
+      speed: Math.random() * 0.015 + 0.005,
+    });
+  }
+
+  return arr;
+}
+
+function makeOrbits() {
+  return ORBIT_DEFS.map((o) => ({
+    rotation: o.rotation,
+    electron: {
+      angle: o.startAngle,
+      speed: o.speed,
+      trail: [],
+    },
+  }));
+}
+
+export function LivingAtom({ className }) {
+  const canvasRef = useRef(null);
+  const reducedMotion = useReducedMotion();
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+
+    if (!canvas) {
+      return undefined;
+    }
+
+    const ctx = canvas.getContext("2d");
+
+    if (!ctx) {
+      return undefined;
+    }
+
+    const dpr = Math.min(window.devicePixelRatio || 1, 2);
+
+    let width = 0;
+    let height = 0;
+    let scale = 1;
+    let rafId = null;
+    let time = 0;
+
+    let mouseX = 0;
+    let mouseY = 0;
+    let targetX = 0;
+    let targetY = 0;
+
+    const nucleons = makeNucleons();
+    const orbits = makeOrbits();
+
+    function renderFrame(isStatic) {
+      if (!width || !height) {
+        return;
+      }
+
+      const cx = width / 2;
+      const cy = height / 2;
+
+      ctx.clearRect(0, 0, width, height);
+      ctx.save();
+
+      if (!isStatic) {
+        mouseX += (targetX - mouseX) * 0.1;
+        mouseY += (targetY - mouseY) * 0.1;
+      }
+
+      ctx.translate(cx + mouseX, cy + mouseY);
+
+      const pulse = isStatic
+        ? 0
+        : Math.sin(time * 0.05) * 15 * scale;
+
+      const glowR = 150 * scale + pulse;
+
+      const bgGlow = ctx.createRadialGradient(
+        0,
+        0,
+        0,
+        0,
+        0,
+        glowR
+      );
+
+      bgGlow.addColorStop(0, "rgba(0,255,255,0.15)");
+      bgGlow.addColorStop(1, "rgba(0,0,0,0)");
+
+      ctx.fillStyle = bgGlow;
+      ctx.beginPath();
+      ctx.arc(0, 0, glowR, 0, Math.PI * 2);
+      ctx.fill();
+
+      nucleons.forEach((p) => {
+        if (!isStatic) {
+          p.angle += p.speed;
+        }
+
+        const px0 = p.ux * 25 * scale;
+        const py0 = p.uy * 25 * scale;
+
+        const px =
+          Math.cos(p.angle) * px0 -
+          Math.sin(p.angle) * py0;
+
+        const py =
+          Math.sin(p.angle) * px0 +
+          Math.cos(p.angle) * py0;
+
+        ctx.beginPath();
+        ctx.arc(
+          px,
+          py,
+          p.baseRadius * scale,
+          0,
+          Math.PI * 2
+        );
+
+        ctx.fillStyle = p.color;
+        ctx.shadowBlur = 15 * scale;
+        ctx.shadowColor = p.color;
+
+        ctx.fill();
+
+        ctx.shadowBlur = 0;
+      });
+
+      const rx = 180 * scale;
+      const ry = 50 * scale;
+
+      orbits.forEach((orbit) => {
+        ctx.save();
+
+        ctx.rotate(
+          orbit.rotation +
+            (isStatic ? 0 : time * 0.002)
+        );
+
+        ctx.beginPath();
+
+        ctx.ellipse(
+          0,
+          0,
+          rx,
+          ry,
+          0,
+          0,
+          Math.PI * 2
+        );
+
+        ctx.strokeStyle = "rgba(0,255,255,0.12)";
+        ctx.lineWidth = 1.2;
+
+        ctx.stroke();
+
+        const e = orbit.electron;
+
+        if (!isStatic) {
+          e.angle += e.speed;
+        }
+
+        const ex = Math.cos(e.angle) * rx;
+        const ey = Math.sin(e.angle) * ry;
+
+        if (!isStatic) {
+          e.trail.push({
+            x: ex,
+            y: ey,
+          });
+
+          if (e.trail.length > 8) {
+            e.trail.shift();
+          }
+
+          ctx.save();
+
+          ctx.strokeStyle = "rgba(0,255,255,0.25)";
+          ctx.lineWidth = 1;
+
+          ctx.beginPath();
+
+          e.trail.forEach((pt, i) => {
+            if (i === 0) {
+              ctx.moveTo(pt.x, pt.y);
+            } else {
+              ctx.lineTo(pt.x, pt.y);
+            }
+          });
+
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        // Electron glow
+        ctx.beginPath();
+
+        ctx.arc(
+          ex,
+          ey,
+          5 * scale,
+          0,
+          Math.PI * 2
+        );
+
+        ctx.fillStyle = "#00ffff";
+        ctx.shadowBlur = 20 * scale;
+        ctx.shadowColor = "#00ffff";
+
+        ctx.fill();
+
+        // Electron center
+        ctx.beginPath();
+
+        ctx.arc(
+          ex,
+          ey,
+          2 * scale,
+          0,
+          Math.PI * 2
+        );
+
+        ctx.fillStyle = "#ffffff";
+        ctx.shadowBlur = 0;
+
+        ctx.fill();
+
+        ctx.restore();
+      });
+
+      ctx.restore();
+    }
+
+    function resize() {
+      const rect = canvas.getBoundingClientRect();
+
+      const w = Math.round(rect.width);
+      const h = Math.round(rect.height);
+
+      if (!w || !h) {
+        return;
+      }
+
+      width = w;
+      height = h;
+
+      scale = Math.min(width, height) / DESIGN_BASE;
+
+      canvas.width = width * dpr;
+      canvas.height = height * dpr;
+
+      ctx.setTransform(
+        dpr,
+        0,
+        0,
+        dpr,
+        0,
+        0
+      );
+
+      if (reducedMotion) {
+        renderFrame(true);
+      }
+    }
+
+    function onMouseMove(e) {
+      const maxOffset =
+        Math.min(width, height) * 0.1;
+
+      targetX = Math.max(
+        -maxOffset,
+        Math.min(
+          maxOffset,
+          (e.clientX - window.innerWidth / 2) * 0.03
+        )
+      );
+
+      targetY = Math.max(
+        -maxOffset,
+        Math.min(
+          maxOffset,
+          (e.clientY - window.innerHeight / 2) * 0.03
+        )
+      );
+    }
+
+    function frame() {
+      time++;
+
+      renderFrame(false);
+
+      rafId = requestAnimationFrame(frame);
+    }
+
+    const ro = new ResizeObserver(resize);
+
+    ro.observe(canvas);
+
+    window.addEventListener(
+      "mousemove",
+      onMouseMove
+    );
+
+    resize();
+
+    if (!reducedMotion) {
+      rafId = requestAnimationFrame(frame);
+    }
+
+    return () => {
+      ro.disconnect();
+
+      window.removeEventListener(
+        "mousemove",
+        onMouseMove
+      );
+
+      if (rafId !== null) {
+        cancelAnimationFrame(rafId);
+      }
+    };
+  }, [reducedMotion]);
+
+  return (
+    <canvas
+      ref={canvasRef}
+      className={className}
+      aria-hidden="true"
+    />
+  );
